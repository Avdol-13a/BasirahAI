# --- Python / backend ---
backend/.venv/
__pycache__/
*.pyc
*.pyo

# --- Secrets — never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
secrets*.json
kaggle.json
*serviceAccountKey*.json

# --- Flutter / Dart (added when app/ is scaffolded) ---
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/local.properties
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/ephemeral/
app/macos/Flutter/ephemeral/
*.iml

# --- Generated localization code — regenerated at build time from
# app/lib/l10n/app_en.arb / app_ur.arb via l10n.yaml (generate: true) ---
app/lib/l10n/app_localizations.dart
app/lib/l10n/app_localizations_en.dart
app/lib/l10n/app_localizations_ur.dart

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
.railway/
.railway-cli-temp/
railway-*.zip
.tools/

# --- Scratch test artifacts ---
backend/*.jpg
backend/*.png
!backend/app/**

# --- APTOS 2019 Kaggle data pulled for the Day 2 evaluation ---
# Competition license is "Competition Use and Non-Commercial & Academic
# Research" — redistribution not permitted. Images, raw CSV, and our sample
# manifest/results are all excluded; only the reproducible scripts are
# tracked. See docs/DATASET.md and docs/EVALUATION_RESULTS.md for the
# permanent, honest record of what was measured.
backend/eval_data/images/
backend/eval_data/train.csv
backend/eval_data/sample_manifest.csv
backend/eval_data/raw_results.json
backend/eval_data/metrics_summary.json

# --- Fundus-gate training/validation artifacts (2026-09-03) — same policy
# as above: reproducible scripts are tracked, generated data/results/caches
# are not. IDRiD (used for external validation only, never training) is not
# redistributable and lives outside this repo entirely; the manifest/results
# below reference its images by local path and are excluded for the same
# reason. See docs/FUNDUS_GATE.md for the permanent, honest record of what
# was measured (training metrics and the IDRiD external-validation numbers).
backend/eval_data/cifar10_kaggle/
backend/eval_data/model_out/
backend/eval_data/fundus_gate_metrics.json
backend/eval_data/idrid_manifest.txt
backend/eval_data/idrid_validation_results.json
